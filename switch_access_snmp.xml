<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
  <version>7.4</version>
  <template_groups>
    <template_group>
      <uuid>346272a40a074be381673690d17d6307</uuid>
      <name>Templates/Network devices</name>
    </template_group>
  </template_groups>
  <templates>
    <template>
      <uuid>a2871ce34f494808aacd29bcf5b90cd4</uuid>
      <template>Switch Access SNMP</template>
      <name>Switch Access SNMP</name>
      <description>Template for HP/Aruba access switches. Monitors ping, CPU, memory, temperature, fans, power supplies and loop protection. Works with HP/Aruba models of varying stack size.</description>
      <groups>
        <group>
          <name>Templates/Network devices</name>
        </group>
      </groups>

      <macros>
        <macro>
          <macro>{$SNMP_COMMUNITY}</macro>
          <value>public</value>
          <description>SNMP v2c community string - override at host level</description>
        </macro>
        <macro>
          <macro>{$CPU_WARN}</macro>
          <value>80</value>
        </macro>
        <macro>
          <macro>{$CPU_CRIT}</macro>
          <value>95</value>
        </macro>
        <macro>
          <macro>{$MEM_WARN}</macro>
          <value>85</value>
        </macro>
        <macro>
          <macro>{$TEMP_WARN}</macro>
          <value>50</value>
        </macro>
        <macro>
          <macro>{$TEMP_CRIT}</macro>
          <value>65</value>
        </macro>
        <macro>
          <macro>{$FAN_MIN_RPM}</macro>
          <value>1000</value>
        </macro>
      </macros>

      <items>

        <!-- SYSTEM -->
        <item>
          <uuid>9fcf5ae7c5ee4b83959c5328478f8826</uuid>
          <name>System - Description</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.2.1.1.1.0</snmp_oid>
          <key>switch.sys.descr</key>
          <delay>3600s</delay>
          <value_type>CHAR</value_type>
          <tags>
            <tag><tag>component</tag><value>system</value></tag>
          </tags>
        </item>

        <item>
          <uuid>1a17aa25ec8d49f5934cd7771f71f64b</uuid>
          <name>System - Uptime</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.2.1.1.3.0</snmp_oid>
          <key>switch.sys.uptime</key>
          <delay>300s</delay>
          <units>uptime</units>
          <preprocessing>
            <step>
              <type>MULTIPLIER</type>
              <parameters>
                <parameter>0.01</parameter>
              </parameters>
            </step>
          </preprocessing>
          <tags>
            <tag><tag>component</tag><value>system</value></tag>
          </tags>
          <triggers>
            <trigger>
              <uuid>5013329ce9b0480489de98300ca8dc8f</uuid>
              <expression>last(/Switch Access SNMP/switch.sys.uptime)&lt;600</expression>
              <name>Switch {HOST.NAME} has restarted</name>
              <priority>WARNING</priority>
            </trigger>
          </triggers>
        </item>

        <!-- ICMP -->
        <item>
          <uuid>3fdb27ee428d4d3db5554434a4a2562f</uuid>
          <name>ICMP Ping - Availability</name>
          <type>SIMPLE</type>
          <key>icmpping</key>
          <delay>60s</delay>
          <valuemap>
            <name>Ping Status</name>
          </valuemap>
          <tags>
            <tag><tag>component</tag><value>availability</value></tag>
          </tags>
          <triggers>
            <trigger>
              <uuid>2c30418d764449eba817b9f7018308f0</uuid>
              <expression>max(/Switch Access SNMP/icmpping,#3)=0</expression>
              <name>Switch {HOST.NAME} is unreachable</name>
              <priority>DISASTER</priority>
            </trigger>
          </triggers>
        </item>

        <item>
          <uuid>b561caf7658c4c22b17ecb83d8bfa9e8</uuid>
          <name>ICMP Ping - Response Time</name>
          <type>SIMPLE</type>
          <key>icmppingsec</key>
          <delay>60s</delay>
          <units>s</units>
          <tags>
            <tag><tag>component</tag><value>availability</value></tag>
          </tags>
        </item>

        <!-- SPEICHER -->
        <item>
          <uuid>ea839199ea6c49c0a83682ee1e4d973a</uuid>
          <name>Memory - Total</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.2.1.25.2.3.1.5.1</snmp_oid>
          <key>switch.mem.total</key>
          <delay>3600s</delay>
          <units>B</units>
          <preprocessing>
            <step>
              <type>MULTIPLIER</type>
              <parameters>
                <parameter>1024</parameter>
              </parameters>
            </step>
          </preprocessing>
          <tags>
            <tag><tag>component</tag><value>memory</value></tag>
          </tags>
        </item>

        <item>
          <uuid>709a85d2286d45398f7a29c54e1bf0e6</uuid>
          <name>Memory - Used</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.2.1.25.2.3.1.6.1</snmp_oid>
          <key>switch.mem.used</key>
          <delay>60s</delay>
          <units>B</units>
          <preprocessing>
            <step>
              <type>MULTIPLIER</type>
              <parameters>
                <parameter>1024</parameter>
              </parameters>
            </step>
          </preprocessing>
          <tags>
            <tag><tag>component</tag><value>memory</value></tag>
          </tags>
        </item>

        <item>
          <uuid>fe1213c8b5f04be09241a48b0d6ed79f</uuid>
          <name>Memory - Used %</name>
          <type>CALCULATED</type>
          <key>switch.mem.pused</key>
          <delay>60s</delay>
          <units>%</units>
          <params>100*last(//switch.mem.used)/last(//switch.mem.total)</params>
          <tags>
            <tag><tag>component</tag><value>memory</value></tag>
          </tags>
          <triggers>
            <trigger>
              <uuid>40ac41dc3431445eb1d7a6a676dd5285</uuid>
              <expression>avg(/Switch Access SNMP/switch.mem.pused,5m)>{$MEM_WARN}</expression>
              <name>Memory usage above {$MEM_WARN}% on {HOST.NAME}</name>
              <priority>WARNING</priority>
            </trigger>
          </triggers>
        </item>

        <!-- SNMP TRAP: LOOP PROTECTION -->
        <item>
          <uuid>d024a32e981040a8af9e56aec44a22a4</uuid>
          <name>SNMP trap: Loop protection</name>
          <type>SNMP_TRAP</type>
          <key>snmptrap[&quot;(?i)loop&quot;]</key>
          <delay>0</delay>
          <value_type>LOG</value_type>
          <description>Empfaengt SNMP Traps bei Loop-Erkennung im Netzwerk</description>
          <tags>
            <tag><tag>component</tag><value>loop</value></tag>
          </tags>
          <triggers>
            <trigger>
              <uuid>d5d43c41e71d48b0b551cf8f93d0366a</uuid>
              <expression>logseverity(/Switch Access SNMP/snmptrap[&quot;(?i)loop&quot;])&gt;=0 and length(last(/Switch Access SNMP/snmptrap[&quot;(?i)loop&quot;]))&gt;0</expression>
              <name>Loop protection trap received on {HOST.NAME}</name>
              <priority>HIGH</priority>
              <description>Ein Netzwerk-Loop wurde erkannt. Sofortige Untersuchung erforderlich.</description>
            </trigger>
          </triggers>
        </item>

      </items>

      <discovery_rules>

        <!-- LLD: CPU -->
        <discovery_rule>
          <uuid>601a1063acee4568baec8c869869cece</uuid>
          <name>CPU Discovery</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>discovery[{#CPU_INDEX},1.3.6.1.2.1.25.3.3.1.2]</snmp_oid>
          <key>switch.cpu.discovery</key>
          <delay>1h</delay>
          <filter>
            <evaltype>AND</evaltype>
            <conditions>
              <condition>
                <macro>{#SNMPINDEX}</macro>
                <value>^196</value>
                <operator>MATCHES_REGEX</operator>
                <formulaid>A</formulaid>
              </condition>
            </conditions>
          </filter>
          <item_prototypes>
            <item_prototype>
              <uuid>8ad294270a334d8e80c590d5241e3bb9</uuid>
              <name>CPU [{#SNMPINDEX}]: Load</name>
              <type>SNMP_AGENT</type>
              <snmp_oid>1.3.6.1.2.1.25.3.3.1.2.{#SNMPINDEX}</snmp_oid>
              <key>switch.cpu.load[{#SNMPINDEX}]</key>
              <delay>60s</delay>
              <units>%</units>
              <tags>
                <tag><tag>component</tag><value>cpu</value></tag>
              </tags>
            </item_prototype>
          </item_prototypes>
          <trigger_prototypes>
            <trigger_prototype>
              <uuid>dda5835d1b2c4be6b4539e422e976da4</uuid>
              <expression>avg(/Switch Access SNMP/switch.cpu.load[{#SNMPINDEX}],5m)>{$CPU_WARN}</expression>
              <name>CPU [{#SNMPINDEX}] above {$CPU_WARN}% on {HOST.NAME}</name>
              <priority>WARNING</priority>
            </trigger_prototype>
            <trigger_prototype>
              <uuid>f7da5e56aa664859b50bf8b8f0fa910f</uuid>
              <expression>avg(/Switch Access SNMP/switch.cpu.load[{#SNMPINDEX}],5m)>{$CPU_CRIT}</expression>
              <name>CPU [{#SNMPINDEX}] CRITICAL above {$CPU_CRIT}% on {HOST.NAME}</name>
              <priority>HIGH</priority>
            </trigger_prototype>
          </trigger_prototypes>
        </discovery_rule>

        <!-- LLD: TEMPERATURE -->
        <discovery_rule>
          <uuid>a2c7077a77c54d40b5a2d286bf85c4c4</uuid>
          <name>Temperature Sensor Discovery</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>discovery[{#SENSOR_UNIT},1.3.6.1.2.1.99.1.1.1.6]</snmp_oid>
          <key>switch.temp.discovery</key>
          <delay>1h</delay>
          <filter>
            <evaltype>AND</evaltype>
            <conditions>
              <condition>
                <macro>{#SENSOR_UNIT}</macro>
                <value>^C$</value>
                <operator>MATCHES_REGEX</operator>
                <formulaid>A</formulaid>
              </condition>
            </conditions>
          </filter>
          <item_prototypes>
            <item_prototype>
              <uuid>9ee5258ad3fe4d72a4cd9fbf3c858e64</uuid>
              <name>Temperature [{#SNMPINDEX}]</name>
              <type>SNMP_AGENT</type>
              <snmp_oid>1.3.6.1.2.1.99.1.1.1.4.{#SNMPINDEX}</snmp_oid>
              <key>switch.temp.value[{#SNMPINDEX}]</key>
              <delay>120s</delay>
              <units>°C</units>
              <preprocessing>
                <step>
                  <type>MULTIPLIER</type>
                  <parameters>
                    <parameter>0.001</parameter>
                  </parameters>
                </step>
              </preprocessing>
              <tags>
                <tag><tag>component</tag><value>temperature</value></tag>
              </tags>
            </item_prototype>
          </item_prototypes>
          <trigger_prototypes>
            <trigger_prototype>
              <uuid>3b0518561b47495e886c49f12be5a466</uuid>
              <expression>last(/Switch Access SNMP/switch.temp.value[{#SNMPINDEX}])>{$TEMP_WARN}</expression>
              <name>Temperature [{#SNMPINDEX}] above {$TEMP_WARN}C on {HOST.NAME}</name>
              <priority>WARNING</priority>
            </trigger_prototype>
            <trigger_prototype>
              <uuid>3c44c25045654690b55a02b0f463f7bf</uuid>
              <expression>last(/Switch Access SNMP/switch.temp.value[{#SNMPINDEX}])>{$TEMP_CRIT}</expression>
              <name>Temperature [{#SNMPINDEX}] CRITICAL above {$TEMP_CRIT}C on {HOST.NAME}</name>
              <priority>HIGH</priority>
            </trigger_prototype>
          </trigger_prototypes>
        </discovery_rule>

        <!-- LLD: FANS -->
        <discovery_rule>
          <uuid>ea8a73b390c1477fa9a4ec92a057bd20</uuid>
          <name>Fan Discovery</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>discovery[{#SENSOR_UNIT},1.3.6.1.2.1.99.1.1.1.6]</snmp_oid>
          <key>switch.fan.discovery</key>
          <delay>1h</delay>
          <filter>
            <evaltype>AND</evaltype>
            <conditions>
              <condition>
                <macro>{#SENSOR_UNIT}</macro>
                <value>^RPM$</value>
                <operator>MATCHES_REGEX</operator>
                <formulaid>A</formulaid>
              </condition>
            </conditions>
          </filter>
          <item_prototypes>
            <item_prototype>
              <uuid>7aafa269d49249b481c388d261f2d31d</uuid>
              <name>Fan [{#SNMPINDEX}]: RPM</name>
              <type>SNMP_AGENT</type>
              <snmp_oid>1.3.6.1.2.1.99.1.1.1.4.{#SNMPINDEX}</snmp_oid>
              <key>switch.fan.rpm[{#SNMPINDEX}]</key>
              <delay>120s</delay>
              <units>RPM</units>
              <tags>
                <tag><tag>component</tag><value>fan</value></tag>
              </tags>
            </item_prototype>
          </item_prototypes>
          <trigger_prototypes>
            <trigger_prototype>
              <uuid>8537dbe11fb74a5c8b13e60080487bf0</uuid>
              <expression>last(/Switch Access SNMP/switch.fan.rpm[{#SNMPINDEX}])&lt;{$FAN_MIN_RPM} and last(/Switch Access SNMP/switch.fan.rpm[{#SNMPINDEX}])&gt;0</expression>
              <name>Fan [{#SNMPINDEX}] below {$FAN_MIN_RPM} RPM on {HOST.NAME}</name>
              <priority>HIGH</priority>
            </trigger_prototype>
          </trigger_prototypes>
        </discovery_rule>

        <!-- LLD: PSU -->
        <discovery_rule>
          <uuid>e65bc6c49e974293a1e83f32d39ef025</uuid>
          <name>PSU Discovery</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>discovery[{#PSU_INDEX},1.3.6.1.2.1.131.1.1.1.3]</snmp_oid>
          <key>switch.psu.discovery</key>
          <delay>1h</delay>
          <filter>
            <evaltype>AND</evaltype>
            <conditions>
              <condition>
                <macro>{#SNMPINDEX}</macro>
                <value>^[0-9]15[0-9]{3}$</value>
                <operator>MATCHES_REGEX</operator>
                <formulaid>A</formulaid>
              </condition>
            </conditions>
          </filter>
          <item_prototypes>
            <item_prototype>
              <uuid>d0b22eaeeb46419e8fb8c40e9cf4cdbc</uuid>
              <name>PSU [{#SNMPINDEX}]: Status</name>
              <type>SNMP_AGENT</type>
              <snmp_oid>1.3.6.1.2.1.131.1.1.1.3.{#SNMPINDEX}</snmp_oid>
              <key>switch.psu.status[{#SNMPINDEX}]</key>
              <delay>120s</delay>
              <valuemap>
                <name>Entity Oper Status</name>
              </valuemap>
              <tags>
                <tag><tag>component</tag><value>psu</value></tag>
              </tags>
            </item_prototype>
          </item_prototypes>
          <trigger_prototypes>
            <trigger_prototype>
              <uuid>adcf9e49d191465586872be909f22d29</uuid>
              <expression>last(/Switch Access SNMP/switch.psu.status[{#SNMPINDEX}])=2</expression>
              <name>CRITICAL: Power supply [{#SNMPINDEX}] failed on {HOST.NAME}</name>
              <priority>HIGH</priority>
              <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
              <recovery_expression>last(/Switch Access SNMP/switch.psu.status[{#SNMPINDEX}])=3</recovery_expression>
            </trigger_prototype>
          </trigger_prototypes>
        </discovery_rule>

      </discovery_rules>

      <valuemaps>
        <valuemap>
          <uuid>02f63bfce4ee4e30977f277449286287</uuid>
          <name>Ping Status</name>
          <mappings>
            <mapping><value>0</value><newvalue>Unreachable</newvalue></mapping>
            <mapping><value>1</value><newvalue>Reachable</newvalue></mapping>
          </mappings>
        </valuemap>
        <valuemap>
          <uuid>071b244c03ba45e6a1d1883994863cc0</uuid>
          <name>Entity Oper Status</name>
          <mappings>
            <mapping><value>1</value><newvalue>Unknown</newvalue></mapping>
            <mapping><value>2</value><newvalue>Disabled</newvalue></mapping>
            <mapping><value>3</value><newvalue>Enabled</newvalue></mapping>
            <mapping><value>4</value><newvalue>Testing</newvalue></mapping>
          </mappings>
        </valuemap>
      </valuemaps>

    </template>
  </templates>
</zabbix_export>
